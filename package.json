{
  "name": "usedexchange",
  "version": "1.9.0",
  "private": true,
  "scripts": {
    "setup-ui": "bash scripts/setup-ui.sh",
    "studio": "tsx scripts/studio.ts",
    "upload-images": "tsx scripts/sync-images.ts --mode upload",
    "configure-image-cors": "tsx scripts/configure-image-cors.ts",
    "create-item": "tsx scripts/create-item.ts",
    "create-template": "tsx scripts/create-template.ts",
    "new": "tsx scripts/create-item.ts",
    "mark-sold": "tsx scripts/mark-sold.ts",
    "mark-available": "tsx scripts/mark-available.ts",
    "duplicate": "tsx scripts/duplicate.ts",
    "inventory": "tsx scripts/inventory.ts",
    "stale-check": "tsx scripts/stale-check.ts",
    "audit-listings": "tsx scripts/audit-listings.ts",
    "export-csv": "tsx scripts/export-csv.ts",
    "semester-end": "tsx scripts/semester-end.ts",
    "fb-export": "tsx scripts/export-facebook.ts",
    "update-site": "tsx scripts/update-site.ts",
    "migrate-config": "tsx scripts/migrate-config.ts",
    "push": "git add content lib/generated/image-manifest.json && git commit -m 'chore: update listings' && git push",
    "bump": "tsx scripts/bump-version.ts",
    "setup-check": "tsx scripts/setup-check.ts",
    "prebuild": "tsx scripts/check-config.ts && tsx scripts/sync-images.ts --mode build-check && tsx scripts/build-search-index.ts",
    "build": "next build",
    "postbuild": "tsx scripts/postbuild.ts",
    "dev": "tsx scripts/sync-images.ts --mode dev-sync && next dev --turbo",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.25",
    "@react-three/fiber": "^9.7.0",
    "@tabler/icons-react": "^3.46.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "jsonc-parser": "^3.3.1",
    "jspdf": "^4.2.1",
    "mini-svg-data-uri": "^1.4.4",
    "motion": "^12.43.0",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^2.6.1",
    "three": "^0.184.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@eslint/eslintrc": "^3.3.7",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^25.0.1",
    "next-sitemap": "^4.2.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^2.1.9"
  }
}
